# Frontend values (safe to expose; use Supabase's publishable/anon key only)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Backend validates the signed-in Supabase session using these same project values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional model override. Default: gemini-3.5-flash-lite (free tier available; quotas apply).
GEMINI_MODEL=gemini-3.5-flash-lite
